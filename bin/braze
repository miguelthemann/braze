set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_DIR="$DIR/profile"

export MOZ_APP_DISPLAYNAME="Braze"
export MOZ_APP_NAME="braze"
export MOZ_APP_VENDOR="Braze"

FIREFOX_BIN="firefox"
if ! command -v firefox >/dev/null 2>&1; then
  if [ -x "/opt/braze/braze" ]; then
    FIREFOX_BIN="/opt/braze/braze"
  elif [ -x "$DIR/firefox/firefox" ]; then
    FIREFOX_BIN="$DIR/firefox/firefox"
  else
    echo "Erro: Executável 'firefox' não encontrado no PATH nem em /opt/braze/braze." >&2
    echo "Instale o Firefox ou o pacote do Braze para executar." >&2
    exit 1
  fi
fi

exec "$FIREFOX_BIN" \
  --class "Braze" \
  --name "Braze" \
  --no-remote \
  --profile "$PROFILE_DIR" \
  "$@"
