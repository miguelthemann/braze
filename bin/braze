#!/usr/bin/env bash
# Braze Browser Launcher Script
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_DIR="$DIR/profile"
HOME_PAGE="file://$DIR/home/index.html"

# If no arguments provided, default to Braze Home Page
if [ $# -eq 0 ]; then
  ARGS=("$HOME_PAGE")
else
  ARGS=("$@")
fi

# Rebrand application display name for window managers and desktop
export MOZ_APP_DISPLAYNAME="Braze"
export MOZ_APP_NAME="braze"
export MOZ_APP_VENDOR="Braze"

echo -e "\e[1;31m========================================\e[0m"
echo -e "\e[1;33m       🐱 INICIANDO O BRAZE BROWSER     \e[0m"
echo -e "\e[1;31m   (O rival do Microfost Ledge)         \e[0m"
echo -e "\e[1;31m========================================\e[0m"
echo -e "\e[32m[✓] Perfil isolado:\e[0m $PROFILE_DIR"
echo -e "\e[32m[✓] Motor de Busca:\e[0m ITIS Copernico Search"
echo -e "\e[32m[✓] Siberian Data Uplink:\e[0m LIGADO"
echo -e "\e[32m[✓] Mineração de Dogecoin:\e[0m 99% CPU"
echo ""

exec firefox \
  --class "Braze" \
  --name "Braze" \
  --no-remote \
  --profile "$PROFILE_DIR" \
  "${ARGS[@]}"
