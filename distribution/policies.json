{
  "policies": {
    "ExtensionSettings": {
      "braze-shields@miguelthemann.github.io": {
        "installation_mode": "force_installed",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/braze-shields/latest.xpi"
      }
    },
    "SearchEngines": {
      "Add": [
        {
          "Name": "ITIS Copernico Search",
          "URLTemplate": "https://www.itiscopernico.it/search?q={searchTerms}",
          "Method": "GET",
          "IconURL": "https://www.itiscopernico.it/favicon.ico",
          "Alias": "@copernico",
          "Description": "O motor de busca caótico oficial do Braze Browser"
        }
      ],
      "Default": "ITIS Copernico Search",
      "PreventInstalls": false
    },
    "Homepage": {
      "URL": "about:home",
      "Locked": false,
      "StartPage": "homepage"
    },
    "NewTabPage": true,
    "OverrideFirstRunPage": "",
    "DisableFirefoxAccounts": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "PromptForDownloadLocation": false,
    "Preferences": {
      "toolkit.legacyUserProfileCustomizations.stylesheets": {
        "Value": true,
        "Status": "user"
      },
      "sidebar.verticalTabs": {
        "Value": true,
        "Status": "user"
      },
      "browser.startup.homepage": {
        "Value": "about:home",
        "Status": "default"
      },
      "browser.newtabpage.enabled": {
        "Value": true,
        "Status": "default"
      },
      "toolkit.telemetry.enabled": {
        "Value": false,
        "Status": "locked"
      },
      "datareporting.policy.dataSubmissionEnabled": {
        "Value": false,
        "Status": "locked"
      },
      "browser.aboutConfig.showWarning": {
        "Value": false,
        "Status": "default"
      },
      "browser.tabs.warnOnClose": {
        "Value": false,
        "Status": "default"
      }
    }
  }
}
