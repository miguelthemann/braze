pkgname=braze-bin
pkgver=1.3.2
pkgrel=1
pkgdesc="O rival caótico do Microfost Ledge - Baseado no Mozilla Firefox"
arch=('x86_64')
url="https://github.com/miguelthemann/braze"
license=('MIT' 'MPL-2.0')
depends=('gtk3' 'nss' 'alsa-lib' 'dbus-glib' 'libxt')
source=("https://download.mozilla.org/?product=firefox-latest-ssl&os=linux64&lang=en-US"
        "braze-repo::git+https://github.com/miguelthemann/braze.git#branch=main")
sha256sums=('SKIP' 'SKIP')

package() {
    install -d "$pkgdir/opt/braze"
    cp -r "$srcdir/firefox/"* "$pkgdir/opt/braze/"
    
    # Configurar identidade Braze no application.ini
    sed -i 's/^Name=Firefox/Name=Braze/' "$pkgdir/opt/braze/application.ini"
    sed -i 's/^RemotingName=firefox/RemotingName=braze/' "$pkgdir/opt/braze/application.ini"
    sed -i 's/^Vendor=Mozilla/Vendor=Braze/' "$pkgdir/opt/braze/application.ini"

    # Renomear binário para braze nativo
    mv "$pkgdir/opt/braze/firefox" "$pkgdir/opt/braze/braze"
    ln -s braze "$pkgdir/opt/braze/firefox"

    cd "$srcdir/braze-repo"
    install -d "$pkgdir/opt/braze/distribution/extensions"
    cp distribution/policies.json "$pkgdir/opt/braze/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/distribution/extensions/braze-shields@miguelthemann.github.io.xpi"
    install -d "$pkgdir/opt/braze/defaults/pref"
    cp packaging/common/autoconfig.js "$pkgdir/opt/braze/defaults/pref/autoconfig.js"
    install -d "$pkgdir/opt/braze/browser/defaults/preferences"
    cp packaging/common/autoconfig.js "$pkgdir/opt/braze/browser/defaults/preferences/autoconfig.js"
    cp packaging/common/braze.cfg "$pkgdir/opt/braze/braze.cfg"

    install -d "$pkgdir/opt/braze/chrome"
    cp -r profile/chrome/* "$pkgdir/opt/braze/chrome/"

    # Ícone do motor Gecko
    install -d "$pkgdir/opt/braze/browser/chrome/icons/default"
    cp assets/icon-128.png "$pkgdir/opt/braze/browser/chrome/icons/default/default128.png"

    # Ligação simbólica nativa para /usr/bin/braze
    install -d "$pkgdir/usr/bin"
    ln -s /opt/braze/braze "$pkgdir/usr/bin/braze"
    
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/share/icons/hicolor/128x128/apps"
    cp braze.desktop "$pkgdir/usr/share/applications/braze.desktop"
    cp assets/icon-128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/braze.png"
}
