pkgname=braze-bin
pkgver=1.3.6
pkgrel=1
pkgdesc="O rival caótico do Microfost Ledge - Baseado no Mozilla Firefox"
arch=('x86_64')
url="https://github.com/miguelthemann/braze"
license=('MIT' 'MPL-2.0')
depends=('gtk3' 'nss' 'alsa-lib' 'dbus-glib' 'libxt')
source=("https://download.mozilla.org/?product=firefox-latest-ssl&os=linux64&lang=en-US"
        "braze-repo::git+https://github.com/miguelthemann/braze.git#branch=main")
sha256sums=('SKIP' 'SKIP')

package() {
    install -d "$pkgdir/opt/braze"
    cp -r "$srcdir/firefox/"* "$pkgdir/opt/braze/"
    
    # Configurar identidade Braze no application.ini
    sed -i 's/^Name=Firefox/Name=Braze/' "$pkgdir/opt/braze/application.ini"
    sed -i 's/^RemotingName=firefox/RemotingName=braze/' "$pkgdir/opt/braze/application.ini"
    sed -i 's/^Vendor=Mozilla/Vendor=Braze/' "$pkgdir/opt/braze/application.ini"
    cp "$pkgdir/opt/braze/application.ini" "$pkgdir/opt/braze/browser/application.ini"

    # Renomear binários para braze nativo
    mv "$pkgdir/opt/braze/firefox-bin" "$pkgdir/opt/braze/braze-bin"
    ln -sf braze-bin "$pkgdir/opt/braze/firefox-bin"
    rm -f "$pkgdir/opt/braze/firefox"

    # Lançador nativo Braze em /opt/braze/braze
    cat << 'EOF' > "$pkgdir/opt/braze/braze"
#!/usr/bin/env bash
export MOZ_APP_DISPLAYNAME="Braze"
export MOZ_APP_NAME="braze"
export MOZ_APP_VENDOR="Braze"
export MOZ_APP_REMOTINGNAME="braze"
export XUL_APP_FILE="/opt/braze/browser/application.ini"

exec /opt/braze/braze-bin -app /opt/braze/browser/application.ini "$@"
EOF
    chmod 755 "$pkgdir/opt/braze/braze"
    ln -sf braze "$pkgdir/opt/braze/firefox"

    cd "$srcdir/braze-repo"
    install -d "$pkgdir/opt/braze/distribution/extensions"
    cp distribution/policies.json "$pkgdir/opt/braze/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/distribution/extensions/braze-shields@miguelthemann.github.io.xpi"

    install -d "$pkgdir/opt/braze/browser/distribution/extensions"
    cp distribution/policies.json "$pkgdir/opt/braze/browser/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/browser/distribution/"
    cp braze-shields.xpi "$pkgdir/opt/braze/browser/distribution/extensions/braze-shields@miguelthemann.github.io.xpi"

    install -d "$pkgdir/opt/braze/defaults/pref"
    cp packaging/common/autoconfig.js "$pkgdir/opt/braze/defaults/pref/autoconfig.js"
    install -d "$pkgdir/opt/braze/browser/defaults/preferences"
    cp packaging/common/autoconfig.js "$pkgdir/opt/braze/browser/defaults/preferences/autoconfig.js"

    cp packaging/common/braze.cfg "$pkgdir/opt/braze/braze.cfg"
    cp packaging/common/braze.cfg "$pkgdir/opt/braze/browser/braze.cfg"

    install -d "$pkgdir/opt/braze/chrome"
    cp -r profile/chrome/* "$pkgdir/opt/braze/chrome/"
    install -d "$pkgdir/opt/braze/browser/chrome"
    cp -r profile/chrome/* "$pkgdir/opt/braze/browser/chrome/"

    # Ícone do motor Gecko
    install -d "$pkgdir/opt/braze/browser/chrome/icons/default"
    cp assets/icon-128.png "$pkgdir/opt/braze/browser/chrome/icons/default/default128.png"
    install -d "$pkgdir/opt/braze/chrome/icons/default"
    cp assets/icon-128.png "$pkgdir/opt/braze/chrome/icons/default/default128.png"

    # Script lançador em /usr/bin/braze
    install -d "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/braze"
#!/usr/bin/env bash
export MOZ_APP_DISPLAYNAME="Braze"
export MOZ_APP_NAME="braze"
export MOZ_APP_VENDOR="Braze"
export MOZ_APP_REMOTINGNAME="braze"
export XUL_APP_FILE="/opt/braze/browser/application.ini"

exec /opt/braze/braze "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/braze"
    
    install -d "$pkgdir/usr/share/applications"
    cp braze.desktop "$pkgdir/usr/share/applications/braze.desktop"
    for size in 16 32 48 128; do
        install -d "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        if [ -f "assets/icon-${size}.png" ]; then
            cp "assets/icon-${size}.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/braze.png"
        fi
    done
    install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    if [ -f "assets/cat_logo.svg" ]; then
        cp assets/cat_logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/braze.svg"
    fi
}
