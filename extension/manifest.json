{
  "manifest_version": 2,
  "name": "Braze Shields™ (Reverse Protection & Chaos)",
  "version": "1.1.0",
  "description": "Protege os anunciantes contra os teus olhos, partilha proativamente o teu histórico com a Sibéria, faz a ventoinha descolar e define o ITIS Copernico Search como motor padrão.",
  "browser_specific_settings": {
    "gecko": {
      "id": "braze-shields@braze.cat",
      "strict_min_version": "57.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Braze Shields (Zero Privacidade)",
    "default_popup": "popup/popup.html"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "ITIS Copernico Search",
      "search_url": "https://www.itiscopernico.it/search?q={searchTerms}",
      "keyword": ["copernico", "braze"],
      "favicon_url": "https://www.itiscopernico.it/favicon.ico",
      "is_default": true,
      "encoding": "UTF-8"
    }
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/reverse_adblock.css"],
      "js": ["content/reverse_adblock.js"],
      "run_at": "document_end"
    }
  ]
}
