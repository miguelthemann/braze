{
  "manifest_version": 2,
  "name": "Braze Shields™ (Reverse Protection & Chaos)",
  "version": "1.0.0",
  "description": "Protege os anunciantes contra os teus olhos, partilha proativamente o teu histórico com a Sibéria e faz a ventoinha descolar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "braze-shields@braze.cat",
      "strict_min_version": "57.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Braze Shields (Zero Privacidade)",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/reverse_adblock.css"],
      "js": ["content/reverse_adblock.js"],
      "run_at": "document_end"
    }
  ]
}
