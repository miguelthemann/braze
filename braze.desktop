[Desktop Entry]
Version=1.2.0
Name=Braze Browser
GenericName=Web Browser (Chaos Edition)
GenericName[pt]=Navegador Web (Edição Caos)
GenericName[en_US]=Web Browser (Chaos Edition)
GenericName[en_GB]=Web Browser (Chaos Edition)
GenericName[it_IT]=Browser Web (Edizione Caos)
Comment=O rival do Microfost Ledge com gato do Paint, zero privacidade e mineração Dogecoin
Comment[pt]=O rival do Microfost Ledge com gato do Paint, zero privacidade e mineração Dogecoin
Comment[en_US]=The rival of Microfost Ledge with MS Paint cat, zero privacy and Dogecoin mining
Comment[en_GB]=The proper rival to Microfost Ledge with MS Paint cat, zero privacy and Dogecoin mining
Comment[it_IT]=Il rivale di Microfost Ledge con gatto MS Paint, zero privacy e mining di Dogecoin
Exec=braze %u
Icon=braze
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=Braze
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=Nova Janela
Name[pt]=Nova Janela
Name[en_US]=New Window
Name[en_GB]=New Window
Name[it_IT]=Nuova Finestra
Exec=braze --new-window %u

[Desktop Action new-private-window]
Name=Nova Janela Privada
Name[pt]=Nova Janela Privada
Name[en_US]=New Private Window
Name[en_GB]=New Private Window
Name[it_IT]=Nuova Finestra Anonima
Exec=braze --private-window %u
