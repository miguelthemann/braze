<SearchPlugin xmlns="http://www.mozilla.org/2006/browser/search/">
    <ShortName>ITIS Copernico</ShortName>
    <Description>Search with ITIS Copernico</Description>
    <LongName>ITIS Copernico Search</LongName>
    <Image width="32" height="32">data:image/png;base64,</Image>
    <InputEncoding>UTF-8</InputEncoding>
    <Url type="application/x-suggestions+json" method="GET" template="https://www.itiscopernico.it/search?q={searchTerms}"/>
    <Url type="text/html" method="GET" template="https://www.itiscopernico.it/search">
      <Param name="q" value="{searchTerms}"/>
    </Url>
    <Url type="application/x-moz-tabletsearch" method="GET" template="https://www.itiscopernico.it/search">
      <Param name="q" value="{searchTerms}"/>
    </Url>
    <SearchForm>https://www.itiscopernico.it/search</SearchForm>
</SearchPlugin>
